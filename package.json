{
  "name": "@stormid/scaffold",
  "version": "1.0.0",
  "description": "Static site builder and UI build system",
  "scripts": {
    "build": "rspack build --config tools/rspack/config/build/index.js",
    "ci": "rspack build --config tools/rspack/config/integration/index.js",
    "dev": "rspack serve --config tools/rspack/config/dev/index.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "start": "npm run dev",
    "test": "node --import ./tools/testing/register.mjs --test",
    "watch": "npm run watch-dev",
    "watch-dev": "rspack build --config tools/rspack/config/integration/index.js --watch"
  },
  "author": "stormid",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@rspack/cli": "^2.0.8",
    "@rspack/core": "^2.0.8",
    "@rspack/dev-server": "^2.0.3",
    "@swc/core": "^1.15.41",
    "browserslist": "^4.28.2",
    "css-loader": "^7.1.4",
    "happy-dom": "^20.10.6",
    "oxlint": "^1.70.0",
    "preact": "^10.21.0",
    "preact-render-to-string": "^6.4.2",
    "sharp": "^0.35.3",
    "svgo": "^3.3.2"
  },
  "dependencies": {
    "@microsoft/applicationinsights-web": "^3.4.1",
    "@stormid/toggle": "^1.0.0"
  }
}

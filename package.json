{
  "name": "@stormid/scaffold",
  "version": "1.0.0",
  "description": "Static site builder and UI build system",
  "scripts": {
    "build": "rspack build --config tools/rspack/config/build/index.js",
    "ci": "rspack build --config tools/rspack/config/integration/index.js",
    "dev": "rspack serve --config tools/rspack/config/dev/index.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "start": "npm run dev",
    "test": "jest",
    "watch": "npm run watch-dev",
    "watch-dev": "rspack build --config tools/rspack/config/integration/index.js --watch"
  },
  "author": "stormid",
  "license": "MIT",
  "jest": {
    "transformIgnorePatterns": [],
    "transform": {
      "^.+\\.jsx?$": [
        "@swc/jest",
        {
          "jsc": {
            "parser": {
              "syntax": "ecmascript",
              "jsx": true
            },
            "transform": {
              "react": {
                "pragma": "h",
                "runtime": "classic"
              }
            }
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^@templates(.*)$": "<rootDir>/src/templates$1",
      "^@layouts(.*)$": "<rootDir>/src/templates/layouts$1",
      "^@components(.*)$": "<rootDir>/src/templates/components$1"
    },
    "testEnvironment": "jsdom"
  },
  "devDependencies": {
    "@rspack/cli": "^2.0.8",
    "@rspack/core": "^2.0.8",
    "@rspack/dev-server": "^2.0.3",
    "@swc/core": "^1.15.41",
    "@swc/jest": "^0.2.39",
    "css-loader": "^7.1.4",
    "eval": "^0.1.8",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "oxlint": "^1.70.0",
    "preact": "^10.21.0",
    "preact-render-to-string": "^6.4.2",
    "sharp": "^0.33.3",
    "svgo": "^3.3.2"
  },
  "dependencies": {
    "@microsoft/applicationinsights-web": "^3.4.1",
    "@stormid/toggle": "^1.0.0"
  }
}

{
  "name": "@stormid/scaffold",
  "version": "1.0.0",
  "description": "Static site builder and UI build system",
  "scripts": {
    "build": "rspack build --config tools/rspack/config/build/index.js",
    "ci": "rspack build --config tools/rspack/config/integration/index.js",
    "dev": "rspack serve --config tools/rspack/config/dev/index.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "start": "npm run dev",
    "test": "node --import ./tools/testing/register.mjs --test",
    "watch": "npm run watch-dev",
    "watch-dev": "rspack build --config tools/rspack/config/integration/index.js --watch"
  },
  "author": "stormid",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@rspack/cli": "^2.2.8",
    "@rspack/core": "^2.2.8",
    "@rspack/dev-server": "^2.2.1",
    "@swc/core": "^1.16.13",
    "browserslist": "^4.29.3",
    "css-loader": "^7.1.5",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.87.0",
    "preact": "^11.0.0",
    "preact-render-to-string": "^6.8.0",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0"
  },
  "dependencies": {
    "@microsoft/applicationinsights-web": "^3.4.5",
    "@stormid/toggle": "^1.1.1"
  }
}
